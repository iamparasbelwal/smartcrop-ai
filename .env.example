# Copy to .env and fill in. Never commit .env.
# Preferred: FreeLLMAPI OpenAI-compatible router (auto-failover across verified models)
FREELM_BASE_URL=http://127.0.0.1:31415/v1
FREELM_API_KEY=

# Fallback: direct Google Gemini API key when the router is unavailable
GEMINI_API_KEY=
# Optional: pin a preferred model ID for either router or Gemini.
GEMINI_MODEL=
